<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Shadow Gradient Under Shield -->
    <path
        android:pathData="M54,20 L24,34 L24,58 C24,78 36,92 54,96 C72,92 84,78 84,58 L84,34 Z"
        android:fillColor="#151C1C1C" />

    <!-- Main Shield Outline in Emerald Tech Green -->
    <path
        android:pathData="M54,20 L24,34 L24,58 C24,78 36,92 54,96 C72,92 84,78 84,58 L84,34 Z"
        android:strokeWidth="4"
        android:strokeColor="#10B981"
        android:fillType="nonZero">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="20"
                android:endX="54"
                android:endY="96"
                android:type="linear">
                <item android:offset="0" android:color="#0D9488" />
                <item android:offset="1" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing Tech Core Pulse Dot in center -->
    <path
        android:pathData="M54,42 A6,6 0 1,1 53.99,42 Z"
        android:fillColor="#34D399" />

    <!-- Secure Integrity Pulse Arch -->
    <path
        android:pathData="M40,56 C44,61 64,61 68,56"
        android:strokeWidth="3.5"
        android:strokeColor="#34D399"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Inner Core Radar Ring -->
    <path
        android:pathData="M54,52 A18,18 0 1,1 53.99,52 Z"
        android:strokeWidth="1.5"
        android:strokeColor="#059669"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
</vector>
